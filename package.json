{
  "name": "action-bundle",
  "version": "0.2.0-beta.1",
  "description": "Turn GitHub Actions into a distributed compute pool: split one workload across many runners, verify the parts, reduce them into one result.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./planner": {
      "types": "./dist/planner.d.ts",
      "default": "./dist/planner.js"
    },
    "./manifest": {
      "types": "./dist/manifest.d.ts",
      "default": "./dist/manifest.js"
    }
  },
  "bin": {
    "action-bundle": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"tests/*.test.mjs\"",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm test && npm run pack:check"
  },
  "keywords": [
    "github-actions",
    "distributed-computing",
    "sharding",
    "matrix",
    "parallel",
    "ci",
    "ci-cd",
    "fan-out",
    "fan-in",
    "map-reduce",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flyingsquirrel0419/Action-bundle.git"
  },
  "bugs": {
    "url": "https://github.com/flyingsquirrel0419/Action-bundle/issues"
  },
  "homepage": "https://github.com/flyingsquirrel0419/Action-bundle#readme",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "typescript": "^5.6.0"
  }
}
